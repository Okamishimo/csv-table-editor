{
	"name": "csv-table-editor",
	"displayName": "CSV Table Editor — Encoding & History",
	"description": "Open, view and edit CSV/TSV files as a spreadsheet grid: sort, filter, search, pick the encoding (UTF-8, UTF-16, Shift_JIS, Windows-1252/1258...), keep a save history and compare versions as a side-by-side table diff.",
	"version": "0.0.13",
	"publisher": "Edgar-Dang",
	"license": "MIT",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/Okamishimo/csv-table-editor.git"
	},
	"bugs": {
		"url": "https://github.com/Okamishimo/csv-table-editor/issues"
	},
	"homepage": "https://github.com/Okamishimo/csv-table-editor#readme",
	"categories": [
		"Data Science",
		"Formatters",
		"Visualization",
		"Other"
	],
	"keywords": [
		"csv",
		"csv editor",
		"csv encoding",
		"csv diff",
		"shift_jis",
		"tsv",
		"csv viewer",
		"csv table",
		"windows-1258",
		"utf-16"
	],
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "CSV Table Editor",
			"properties": {
				"csvTableEditor.fontFamily": {
					"type": "string",
					"default": "",
					"scope": "window",
					"description": "CSS font-family value used by the CSV grid and large-file preview. For example: 'Microsoft JhengHei', 'Noto Sans TC', sans-serif. Leave empty to use the VS Code interface font."
				},
				"csvTableEditor.maxFileSizeMB": {
					"type": "number",
					"default": 64,
					"minimum": 1,
					"maximum": 511,
					"scope": "window",
					"description": "Maximum CSV/TSV size in MiB loaded directly into the editable in-memory grid. Larger local files open in a paged, streaming, read-only preview. Raising this value can use substantial memory."
				},
				"csvTableEditor.updates.enabled": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "Automatically install stable updates from the private Okamishimo/csv-table-editor GitHub Releases after authentication is configured."
				},
				"csvTableEditor.updates.checkIntervalHours": {
					"type": "number",
					"default": 6,
					"minimum": 1,
					"maximum": 168,
					"scope": "application",
					"description": "Hours between automatic private update checks. Failed attempts also respect this interval."
				},
				"csvTableEditor.updates.profileName": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "Exact VS Code profile name for CLI updates when using a named profile. Leave empty for the default profile."
				}
			}
		},
		"customEditors": [
			{
				"viewType": "csvTableEditor.editor",
				"displayName": "CSV Table Editor",
				"selector": [
					{
						"filenamePattern": "*.csv"
					},
					{
						"filenamePattern": "*.tsv"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "csvTableEditor.checkForUpdates",
				"title": "Check for Extension Updates",
				"category": "CSV Table Editor"
			},
			{
				"command": "csvTableEditor.configureUpdateAuthentication",
				"title": "Configure Private Update Authentication",
				"category": "CSV Table Editor"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run build && npm test",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "npm run patch:dist && npm test",
		"lint": "eslint src --ext ts",
		"patch:dist": "node scripts/patch-distribution.js",
		"test": "node --test test/*.test.js",
		"build": "npm run patch:dist && node scripts/check-syntax.js"
	},
	"dependencies": {
		"iconv-lite": "^0.6.3"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.9.2",
		"jsdom": "^30.0.1",
		"ts-loader": "^9.5.1",
		"typescript": "^5.3.3",
		"webpack": "^5.90.0",
		"webpack-cli": "^5.1.4",
		"yauzl": "^3.4.0",
		"yazl": "^2.5.1"
	},
	"__metadata": {
		"installedTimestamp": 1788502981135,
		"targetPlatform": "undefined",
		"size": 914016
	}
}
